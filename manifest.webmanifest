---
---
{
  "lang": "{{- site.lang -}}",
  "dir": "ltr",
  "name": "{{- site.name -}}",
  "short_name": "{{- site.short_name -}}",
  "icons": [
    {
      "src": "{{ '/assets/img/icon.svg' | relative_url }}",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "{{ '/assets/img/icon.png' | relative_url }}",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "scope": "{{- '/' | relative_url -}}",
  "id": "{{- site.url -}}",
  "start_url": "{{- '/' | relative_url -}}",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "{{- site.theme_color -}}",
  "background_color": "{{- site.background_color -}}"
}
